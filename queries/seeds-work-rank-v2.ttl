  q:parameter [ a q:QueryParameter ; q:parameterName "id45" ; q:parameterIndex 48 ; q:parameterKind "text" ; q:required false ; q:defaultValue "" ] ;
  q:parameter [ a q:QueryParameter ; q:parameterName "id46" ; q:parameterIndex 49 ; q:parameterKind "text" ; q:required false ; q:defaultValue "" ] ;
  q:parameter [ a q:QueryParameter ; q:parameterName "id47" ; q:parameterIndex 50 ; q:parameterKind "text" ; q:required false ; q:defaultValue "" ] ;
  q:parameter [ a q:QueryParameter ; q:parameterName "id48" ; q:parameterIndex 51 ; q:parameterKind "text" ; q:required false ; q:defaultValue "" ] ;
  q:parameter [ a q:QueryParameter ; q:parameterName "id49" ; q:parameterIndex 52 ; q:parameterKind "text" ; q:required false ; q:defaultValue "" ] ;
  q:parameter [ a q:QueryParameter ; q:parameterName "id50" ; q:parameterIndex 53 ; q:parameterKind "text" ; q:required false ; q:defaultValue "" ] ;
  q:parameter [ a q:QueryParameter ; q:parameterName "id51" ; q:parameterIndex 54 ; q:parameterKind "text" ; q:required false ; q:defaultValue "" ] ;
  q:parameter [ a q:QueryParameter ; q:parameterName "id52" ; q:parameterIndex 55 ; q:parameterKind "text" ; q:required false ; q:defaultValue "" ] ;
  q:parameter [ a q:QueryParameter ; q:parameterName "id53" ; q:parameterIndex 56 ; q:parameterKind "text" ; q:required false ; q:defaultValue "" ] ;
  q:parameter [ a q:QueryParameter ; q:parameterName "id54" ; q:parameterIndex 57 ; q:parameterKind "text" ; q:required false ; q:defaultValue "" ] ;
  q:parameter [ a q:QueryParameter ; q:parameterName "id55" ; q:parameterIndex 58 ; q:parameterKind "text" ; q:required false ; q:defaultValue "" ] ;
  q:parameter [ a q:QueryParameter ; q:parameterName "id56" ; q:parameterIndex 59 ; q:parameterKind "text" ; q:required false ; q:defaultValue "" ] ;
  q:parameter [ a q:QueryParameter ; q:parameterName "id57" ; q:parameterIndex 60 ; q:parameterKind "text" ; q:required false ; q:defaultValue "" ] ;
  q:parameter [ a q:QueryParameter ; q:parameterName "id58" ; q:parameterIndex 61 ; q:parameterKind "text" ; q:required false ; q:defaultValue "" ] ;
  q:parameter [ a q:QueryParameter ; q:parameterName "id59" ; q:parameterIndex 62 ; q:parameterKind "text" ; q:required false ; q:defaultValue "" ] ;
  q:parameter [ a q:QueryParameter ; q:parameterName "id60" ; q:parameterIndex 63 ; q:parameterKind "text" ; q:required false ; q:defaultValue "" ] ;
  q:parameter [ a q:QueryParameter ; q:parameterName "id61" ; q:parameterIndex 64 ; q:parameterKind "text" ; q:required false ; q:defaultValue "" ] ;
  q:parameter [ a q:QueryParameter ; q:parameterName "id62" ; q:parameterIndex 65 ; q:parameterKind "text" ; q:required false ; q:defaultValue "" ] ;
  q:parameter [ a q:QueryParameter ; q:parameterName "id63" ; q:parameterIndex 66 ; q:parameterKind "text" ; q:required false ; q:defaultValue "" ] ;
  q:sparqlTemplate """PREFIX schema: <https://schema.org/>
PREFIX s: <https://seeds.local/ontology/>
PREFIX ical: <http://www.w3.org/2002/12/cal/ical#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT ?id ?revision ?priority ?status ?assignee ?due_at ?created_at ?sampled_at
       ?deferral_observation ?observed_deferral_writes ?deferral_observed_since WHERE {
  VALUES ?id { '{id00}' '{id01}' '{id02}' '{id03}' '{id04}' '{id05}' '{id06}' '{id07}' '{id08}' '{id09}' '{id10}' '{id11}' '{id12}' '{id13}' '{id14}' '{id15}' '{id16}' '{id17}' '{id18}' '{id19}' '{id20}' '{id21}' '{id22}' '{id23}' '{id24}' '{id25}' '{id26}' '{id27}' '{id28}' '{id29}' '{id30}' '{id31}' '{id32}' '{id33}' '{id34}' '{id35}' '{id36}' '{id37}' '{id38}' '{id39}' '{id40}' '{id41}' '{id42}' '{id43}' '{id44}' '{id45}' '{id46}' '{id47}' '{id48}' '{id49}' '{id50}' '{id51}' '{id52}' '{id53}' '{id54}' '{id55}' '{id56}' '{id57}' '{id58}' '{id59}' '{id60}' '{id61}' '{id62}' '{id63}' }
  FILTER (?id != '')
  GRAPH <{board}> {
    ?item schema:identifier ?id ; schema:version ?revision ; s:priority ?priority ;
          s:status ?status ; schema:dateCreated ?created_term .
    BIND(STR(?created_term) AS ?created_at)
    OPTIONAL { ?item schema:agent ?assignee_term .
      BIND(IF(isIRI(?assignee_term) && STR(?assignee_term) = CONCAT('https://seeds.local/principal/', '{owner}'),
           '{owner}', STR(?assignee_term)) AS ?assignee)
    }
    OPTIONAL { ?item ical:due ?due_term . BIND(STR(?due_term) AS ?due_at) }
    BIND(EXISTS { ?item schema:keywords 'stiwi-directive' } AS ?directive)
    OPTIONAL { ?item s:observedDeferralWriteCount ?deferral_count_term }
    OPTIONAL { ?item s:observedDeferralWriteCountSince ?deferral_since_term }
    BIND(IF(!BOUND(?deferral_count_term) && !BOUND(?deferral_since_term), 'UNKNOWN',
         IF(BOUND(?deferral_count_term) && BOUND(?deferral_since_term)
            && DATATYPE(?deferral_count_term) = xsd:integer
            && ?deferral_count_term >= 1 && ?deferral_count_term <= 9223372036854775807
            && DATATYPE(?deferral_since_term) = xsd:dateTime
            && xsd:dateTime(?deferral_since_term) <= xsd:dateTime('{now}'),
            'OBSERVED', 'INVALID')) AS ?deferral_observation)
    BIND(?deferral_count_term AS ?observed_deferral_writes)
    BIND(STR(?deferral_since_term) AS ?deferral_observed_since)
    BIND(IF(?deferral_observation = 'OBSERVED',
         IF(?deferral_count_term > 64, 64, ?deferral_count_term), 0) AS ?deferral_weight)

  }
  FILTER(BOUND(?deferral_observation) && ?deferral_observation IN ('UNKNOWN', 'OBSERVED'))
  FILTER (!BOUND(?assignee) || STR(?assignee) = '' || STR(?assignee) = '{owner}' || STRENDS(STR(?assignee), CONCAT('/', '{owner}')))
  BIND('{now}' AS ?sampled_at)
  BIND(xsd:dateTime(?created_at) AS ?created_time)
  BIND(IF(DATATYPE(?due_term) = xsd:date || STRLEN(?due_at) = 10,
       xsd:dateTime(CONCAT(SUBSTR(?due_at, 1, 10), 'T00:00:00', IF(STRLEN(?due_at) = 10, 'Z', SUBSTR(?due_at, 11)))),
       xsd:dateTime(?due_at)) AS ?due_time)
  FILTER(BOUND(?created_time) && (!BOUND(?due_term) || BOUND(?due_time)))
  BIND(IF(BOUND(?due_term), IF(?due_time <= xsd:dateTime('{now}'), 0, 1), 2) AS ?due_band)
}
ORDER BY ?priority ?due_band ?due_time DESC(?directive) DESC(?deferral_weight) ?created_time ?id
LIMIT 65""" .
