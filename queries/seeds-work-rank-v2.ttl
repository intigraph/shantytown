<urn:quipu:query:seeds_work_rank_v2> a q:StoredQuery ;
  q:queryName "seeds_work_rank_v2" ;
  q:queryForm "SELECT" ;
  dct:description "Exact candidate pickup order: declared priority, due/overdue, explicit directive, observed deferral lower bound and age. Revision witnesses required; missing/changed/capped answers cannot authorize pickup. Read-only first slice of backlog ranking; no dependency promotion or authority inferred from labels." ;
  q:parameter [ a q:QueryParameter ; q:parameterName "board" ; q:parameterIndex 0 ; q:parameterKind "iri" ; q:required true ] ;
  q:parameter [ a q:QueryParameter ; q:parameterName "owner" ; q:parameterIndex 1 ; q:parameterKind "text" ; q:required true ] ;
  q:parameter [ a q:QueryParameter ; q:parameterName "now" ; q:parameterIndex 2 ; q:parameterKind "text" ; q:required true ] ;
  q:parameter [ a q:QueryParameter ; q:parameterName "id00" ; q:parameterIndex 3 ; q:parameterKind "text" ; q:required false ; q:defaultValue "" ] ;
